# ============================================================
#  Türkçe Altyazı Eklentisi - Yapılandırma
#  Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun:
#    cp .env.example .env
# ============================================================

# --- Sunucu ---
# Eklentinin dinleyeceği port
PORT=7000
# Stremio'nun altyazı dosyalarını çekeceği adres.
# Aynı bilgisayarda izliyorsanız varsayılan yeterli.
# Telefon/başka cihazdan izleyecekseniz buraya bilgisayarınızın LAN IP'sini yazın:
#   örn: http://192.168.1.20:7000
BASE_URL=http://127.0.0.1:7000

# --- OpenSubtitles (İngilizce altyazı kaynağı) ---
# ZORUNLU. Ücretsiz API anahtarı:
#   1) https://www.opensubtitles.com adresinde ücretsiz hesap açın
#   2) Profil > "API Consumers" / "Consumers" bölümünden yeni bir uygulama oluşturun
#   3) Size verilen "Api Key" değerini buraya yapıştırın
OPENSUBTITLES_API_KEY=

# İSTEĞE BAĞLI ama ÖNERİLİR: kullanıcı adı + parola girerseniz günlük indirme
# kotanız yükselir (anonim ~5/gün yerine kayıtlı kullanıcıda çok daha fazla).
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# OpenSubtitles, uygulamanızı tanıyan bir User-Agent ister. İstediğiniz adı verin.
OPENSUBTITLES_USER_AGENT=TurkishSubsTranslator v1.0

# --- Çeviri sağlayıcısı ---
# Seçenekler: libretranslate | google | deepl | mymemory
TRANSLATE_PROVIDER=libretranslate

# Kaynak ve hedef dil (LibreTranslate/DeepL dil kodları)
SOURCE_LANG=en
TARGET_LANG=tr
# Stremio'da gösterilecek dil kodu (ISO 639-2). 'tur' = Türkçe.
SUBTITLE_LANG=tur

# LibreTranslate (varsayılan, açık kaynak, çevrimdışı)
# docker-compose ile çalıştırıyorsanız konteyner içinden: http://libretranslate:5000
# kendiniz çalıştırıyorsanız: http://127.0.0.1:5000
LIBRETRANSLATE_URL=http://127.0.0.1:5000
# Bazı LibreTranslate sunucuları API anahtarı ister; kendi sunucunuzda gerekmez.
LIBRETRANSLATE_API_KEY=

# DeepL (TRANSLATE_PROVIDER=deepl seçerseniz)
DEEPL_API_KEY=
# Ücretsiz anahtar için true, Pro için false
DEEPL_FREE=true

# MyMemory (TRANSLATE_PROVIDER=mymemory seçerseniz)
# E-posta girerseniz günlük limit yükselir
MYMEMORY_EMAIL=

# --- Davranış / performans ---
# Kaç altyazı adayı önerilsin (en iyi eşleşme her zaman ilk sırada)
MAX_RESULTS=3
# Çeviri istekleri için eşzamanlılık (LibreTranslate'i zorlamayın)
TRANSLATE_CONCURRENCY=4
# Çevrilmiş dosyaların önbellek dizini
CACHE_DIR=.cache
# Servis edilen altyazı için tarayıcı/Stremio önbellek süresi (saniye)
CACHE_MAX_AGE=604800
# Türkçe karakter kodlaması sorunu yaşarsanız true yapın; Stremio'nun yerel
# sunucusu (127.0.0.1:11470) üzerinden kodlama düzeltmesi uygular.
USE_STREMIO_PROXY=false
